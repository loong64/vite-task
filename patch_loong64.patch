diff --git a/.cargo/zigcc-loongarch64-unknown-linux-musl b/.cargo/zigcc-loongarch64-unknown-linux-musl
new file mode 100644
index 00000000..3d1b0481
--- /dev/null
+++ b/.cargo/zigcc-loongarch64-unknown-linux-musl
@@ -0,0 +1,7 @@
+#!/bin/sh
+# Linker wrapper for loongarch64-unknown-linux-musl targets.
+# On Linux, use the system cc directly. On other hosts, cross-compile via cargo-zigbuild.
+if [ "$(uname -s)" = "Linux" ]; then
+  exec cc "$@"
+fi
+exec cargo-zigbuild zig cc -- -fno-sanitize=all -target loongarch64-linux-musl "$@"
