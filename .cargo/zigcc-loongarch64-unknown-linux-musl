#!/bin/sh
# Linker wrapper for loongarch64-unknown-linux-musl targets.
# Always use Zig: a Linux host's system cc normally targets glibc, not musl.
if command -v cargo-zigbuild >/dev/null 2>&1; then
  exec cargo-zigbuild zig cc -- -fno-sanitize=all -target loongarch64-linux-musl "$@"
fi
exec zig cc -fno-sanitize=all -target loongarch64-linux-musl "$@"
